[node name="BoostText" type="Label" parent="Panel/TabContainer/Controls"]
offset_top = 390.0
offset_right = 1060.0
offset_bottom = 470.0
theme_override_colors/font_color = Color(0.8, 0.8, 0.8, 1)
theme_override_font_sizes/font_size = 14
autowrap_mode = 1
text = "Tab / X Button = Activate boost. 2x speed for 1.5s. Invincible while boosting.\n3 charges by default. Each charge takes 8s to recharge.\nUpgrade boost capacity in the Garage for more charges."

