[node name="HazardsText" type="Label" parent="Panel/TabContainer/Hazards"]
offset_top = 30.0
offset_right = 1060.0
offset_bottom = 250.0
theme_override_colors/font_color = Color(0.8, 0.8, 0.8, 1)
theme_override_font_sizes/font_size = 14
autowrap_mode = 1
text = "Debris / Construction Barrels = Obstacles in the road. Collision deals 1 dmg.\n\nDeadly Obstacles (rocks, wrecked cars) = Instant kill if hit without boost. Can be destroyed while boosting.\n\nIce Surface = Slippery handling. Lateral movement is much slower and less responsive.\n\nBridge Sections = Gaps on the sides. Falling off deals 2 dmg and teleports you back.\n\nAcid Rain (Tier 8+) = Deals 1 dmg every 2s automatically.\n\nLightning (Tier 12+) = Random strikes deal 1 dmg if within range."

[node name="EnemiesTitle" type="Label" parent="Panel/TabContainer/Hazards"]
offset_top = 260.0
offset_right = 100.0
offset_bottom = 290.0
theme_override_colors/font_color = Color(0, 0.8, 1, 1)
theme_override_font_sizes/font_size = 18
text = "ENEMIES"

[node name="EnemiesText" type="Label" parent="Panel/TabContainer/Hazards"]
offset_top = 290.0
offset_right = 1060.0
offset_bottom = 490.0
theme_override_colors/font_color = Color(0.8, 0.8, 0.8, 1)
theme_override_font_sizes/font_size = 14
autowrap_mode = 1
text = "Bunny = Bounces toward your lane. Contact = 1 dmg.\nRotor = Weaves side-to-side, follows your X position. Contact = 1 dmg.\nScav = Flanks you, shoots bullets, rams at close range. 1 dmg.\nDrone = Hovers above, drops timed bombs. Bomb = 2 dmg.\n\nPickups (from destroyed enemies): Repair (heal 1 HP), Ammo (+1 to all weapons), Boost (+1 charge), Multiplier (2x score for 10s)."
