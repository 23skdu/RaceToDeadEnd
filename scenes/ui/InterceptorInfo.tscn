[node name="WeaponsText" type="Label" parent="Panel/TabContainer/Controls"]
offset_top = 140.0
offset_right = 1060.0
offset_bottom = 350.0
theme_override_colors/font_color = Color(0.8, 0.8, 0.8, 1)
theme_override_font_sizes/font_size = 14
autowrap_mode = 1
text = "Space / A Button = Primary Fire (rapid-fire machine gun)\nQ / Y Button = Cycle weapon (Missile -> Mine -> EMP)\n\nShift / B Button = Fire selected secondary weapon\n\nHoming Missile (red): Fires a missile that homes onto the nearest enemy. 3 dmg.\n\nProximity Mine (yellow): Drops a mine behind you. Arms after 0.5s. Deals 2 dmg on contact.\n\nEMP Blast (cyan): Expanding energy wave that stuns all enemies for 2s. Deals 1 dmg.\n\nE = Fire EMP directly (no need to cycle)\nM = Drop Mine directly (no need to cycle)"

[node name="BoostTitle" type="Label" parent="Panel/TabContainer/Controls"]
offset_top = 360.0
offset_right = 100.0
offset_bottom = 390.0
theme_override_colors/font_color = Color(0, 0.8, 1, 1)
